NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wayinn
# set true for Neon / managed Postgres
DATABASE_SSL=false
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
GUEST_JWT_EXPIRES_IN=24h
CORS_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
# Outgoing WhatsApp / SMS / email: sent by the API every 30 s. Set false if `npm run outbox -- --watch` runs as its own process.
OUTBOX_IN_API=true
# Meta Graph API version for WhatsApp Cloud API
WHATSAPP_GRAPH_VERSION=v22.0
